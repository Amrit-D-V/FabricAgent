*.html
*.pdf

# tests/ used to be ignored wholesale. That silently untracked every test
# written in the conventional location — the suite would look present locally
# and be absent from the repo. Test code is source; only its artifacts are not.
.pytest_cache/
tests/**/__pycache__/


# App master encryption key (org LLM keys at rest) — never commit
.app_secret_key

# Neo4j org-memory exports (client data, local backups only)
neo4j_backup_*.json

# Local backups: database snapshots and org-memory exports. Client data — this
# directory must never be committed. The db.bak_*/db.corrupt_* files WERE
# committed once (42993b4, acdf66f, 237523c) and are still in the pushed
# history; moving them here does not undo that, see HANDOVER section 5.
backups/

# graphify code graph — regenerated from source in ~20s, and carries an AST
# cache plus a full structural map of the codebase. Rebuild it, don't commit it:
#   graphify update .
graphify-out/

theme-void/

# --- The React app is source ------------------------------------------------
# Several rules above are aimed at Python build output and generated files, and
# they were silently swallowing the frontend: `lib/` took web/src/lib (the API
# client, session, nav registry, SSE helper), `/assets/` took web/src/assets
# (the logo and the mascot), and `*.html` took web/index.html, the app's entry
# point. A fresh clone produced a React app that could not build.
#
# Negations, rather than editing the rules above, so the Python intent of each
# is left intact.
!web/index.html
!web/src/
!web/src/**
!web/public/
!web/public/**
# Still generated, still ignored.
web/node_modules/
web/dist/
web/.env.local

