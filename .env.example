# FabricBI environment. Copy to .env and fill in — .env is gitignored, this file
# is not, so never paste a real secret below.
#
#   cp .env.example .env
#
# Every variable the code reads is listed here. Almost all of them have a
# working default and can stay commented out; the few that do not are marked
# REQUIRED. Placeholder values are safe examples, not live settings.
#
# REQUIRED TO BOOT (import fails without it):
#   PROJECTS_DIR
#
# REQUIRED IN PRACTICE (the app starts, but the feature is dead without it):
#   ANTHROPIC_API_KEY      the assistant cannot answer
#   APP_ENCRYPTION_KEY     saved Fabric credentials do not survive a restart
#   AZURE_TENANT_ID / AZURE_CLIENT_ID / AZURE_CLIENT_SECRET   no Fabric access


# =============================================================================
# Storage and database
# =============================================================================

# REQUIRED. Root of the per-project PBIP tree. No default: a wrong value here
# is silent data loss, so the app refuses to start rather than guess.
#   Linux / macOS:  /data/projects        Windows:  C:\FabricBI-storage
PROJECTS_DIR=/data/projects

# Scratch space for artifacts pulled down from Fabric. Default: PROJECTS_DIR/fabricbi_temp
# FABRICBI_TEMP_DIR=/data/projects/fabricbi_temp

# SQLite file holding projects, users, and saved connections. Default: ./project_data.db
# DB_PATH=/data/project_data.db

# Where uploaded files land. Default: ./uploads
# UPLOADS_DIR=/data/uploads

# SQLite journal mode. Must be DELETE on SMB/NFS mounts — WAL needs a shared
# -shm mapping network filesystems do not implement. Default: WAL
# SQLITE_JOURNAL_MODE=WAL

# Seconds a write waits on a locked database before erroring. Default: 15
# SQLITE_BUSY_TIMEOUT_S=15


# =============================================================================
# LLM provider routing
# =============================================================================

# Default provider for every agent: anthropic, codex_cli, openai,
# gemini, groq, openrouter, ollama. Default: anthropic
# LLM_PROVIDER=anthropic

# Per-pipeline provider overrides. Each defaults to LLM_PROVIDER.
# SEMANTIC_MODEL_PROVIDER=anthropic
# DASHBOARD_PROVIDER=anthropic
# WIREFRAME_PROVIDER=anthropic
# ASSISTANT_PROVIDER=anthropic
# SMALL_TASK_PROVIDER=anthropic
# BIG_TASK_PROVIDER=anthropic

# Tiered routing: agents are classed mechanical or creative, and a tier with a
# provider set here wins over the per-pipeline overrides above. Default: unset
# LLM_MECHANICAL_PROVIDER=ollama
# LLM_MECHANICAL_MODEL=qwen2.5-coder:latest
# LLM_CREATIVE_PROVIDER=anthropic
# LLM_CREATIVE_MODEL=claude-sonnet-4-6

# Tier applied to an agent that matches no name in the tier table. Default: creative
# LLM_DEFAULT_TIER=creative


# =============================================================================
# Provider credentials and models
# =============================================================================

# Anthropic API key — the assistant and every anthropic-provider agent need it.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# Model used by the anthropic provider. Default: claude-sonnet-4-6
# ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI. Key name is fixed; base URL only for an Azure/compatible gateway.
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o

# Google Gemini, over its OpenAI-compatible endpoint.
# GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# GEMINI_MODEL=gemini-3.6-flash

# Groq.
# GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter.
# OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxx
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=openai/gpt-4o

# Ollama, for a model served on this machine.
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=gpt-oss:20b
# OLLAMA_NUM_CTX=8192
# OLLAMA_MAX_TOKENS=3072

# Hugging Face Inference / router.
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxx
# HUGGINGFACE_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct
# HF_ROUTER_MODEL=deepseek-ai/DeepSeek-V4-Pro:novita
# HF_MAX_NEW_TOKENS=8192


# =============================================================================
# Claude Code CLI and Codex CLI providers
# =============================================================================

# Model id — a real id, never a display label; it is passed to `claude --model`.
# Default: claude-sonnet-4-6
# CLAUDE_CLI_MODEL=claude-sonnet-4-6

# Model for the non-technical "general" chat mode. Default: claude-sonnet-4-6
# GENERAL_MODE_MODEL=claude-sonnet-4-6

# Cap on agent turns in one CLI run. Default: 40
# CLAUDE_CLI_MAX_TURNS=40

# Keep one CLI connection warm between turns instead of respawning. Default: 0
# CLAUDE_CLI_REUSE_CONNECTION=0

# Seconds a reused CLI connection may sit idle before it is dropped. Default: 900
# CLAUDE_CLI_CONN_IDLE_S=900

# Self-check passes after a CLI build. Default: 2
# CLAUDE_CLI_VERIFY_ROUNDS=2

# Verify the model id before running (1) or trust it (0). Default: 1
# CLAUDE_CLI_VERIFY_MODEL=1

# Model id for the codex_cli provider. Default: gpt-5.5
# CODEX_CLI_MODEL=gpt-5.5

# Repair passes the pipeline agents run over their own output. Default: 2
# AGENT_VERIFY_ROUNDS=2
# OUTPUT_VERIFY_ROUNDS=2

# Send heavy build steps to the Anthropic API even when another provider is
# selected. Default: 0
# BUILD_AUTO_ROUTE_ANTHROPIC=0

# Show each tool call in the chat transcript. Default: off
# SHOW_TOOL_CALLS=1


# =============================================================================
# Azure / Fabric service principal
# =============================================================================
# The BACKEND service principal. It must carry NO admin-consent Power BI
# permissions, or the Scanner API 401s — sign-in uses the separate ENTRA_SSO_*
# app below.

AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=

# Pins azure-identity to non-interactive credentials. The app sets this itself
# when all three values above are present; only set it to override.
# AZURE_TOKEN_CREDENTIALS=prod

# Encrypts saved Fabric credentials at rest. Without it a throwaway key is
# generated per boot, so stored connections do not survive a restart.
#   openssl rand -hex 32
APP_ENCRYPTION_KEY=


# =============================================================================
# Fabric workspace and model targeting
# =============================================================================

# Default workspace name, and its stable id (survives a rename).
# FABRIC_WORKSPACE=your-workspace-name
# FABRIC_WORKSPACE_ID=00000000-0000-0000-0000-000000000000

# Default semantic model, and the comma-separated list the pickers offer.
# FABRIC_MODEL=Sales Model
# FABRIC_MODELS=Sales Model,Finance Model

# Default dataset id used by the Reports page.
# FABRIC_DATASET_ID=00000000-0000-0000-0000-000000000000

# Fabric SQL database the SQL tools query.
# FABRIC_SQL_DB_ID=00000000-0000-0000-0000-000000000000

# Fabric SQL database backing the app itself, when not on SQLite.
# FABRIC_APP_DB_SERVER=xxxxxxxx.datawarehouse.fabric.microsoft.com
# FABRIC_APP_DB_NAME=fabricbi

# Endpoints. Change only for a sovereign or gov cloud.
# POWERBI_API_BASE=https://api.powerbi.com/v1.0/myorg
# XMLA_ENDPOINT_BASE=powerbi://api.powerbi.com/v1.0/myorg

# Seconds a cached XMLA connection is reused. Default: 300
# XMLA_CONN_TTL_S=300

# Set by scripts/qa_mini_build.py to pin the workspace and models for one run;
# not something to put in .env.
# PBI_ACTIVE_WORKSPACE=
# PBI_ACTIVE_MODELS=


# =============================================================================
# Sign-in (Microsoft Entra) and session
# =============================================================================

# Where Entra sends the user back after sign-in. Must match the app
# registration exactly. Default: http://localhost:8501
# ENTRA_REDIRECT_URI=https://fabricbi.example.com

# The SIGN-IN app registration, deliberately separate from AZURE_CLIENT_*: it
# needs a delegated Power BI scope the backend SP must not have. Each falls
# back to its AZURE_* counterpart until the split registration exists.
# ENTRA_SSO_TENANT_ID=00000000-0000-0000-0000-000000000000
# ENTRA_SSO_CLIENT_ID=00000000-0000-0000-0000-000000000000
# ENTRA_SSO_CLIENT_SECRET=

# Mark the session cookie Secure. Defaults to on whenever ENTRA_REDIRECT_URI is
# https, which is why local http development still works.
# SESSION_COOKIE_SECURE=1


# =============================================================================
# Fabric access gate
# =============================================================================

# Gate project visibility on real Fabric workspace membership. Off until the
# split sign-in registration exists, or every lookup fails and hides
# everything. Default: off
# FABRIC_ACCESS_GATE=1

# Seconds a user's workspace list is trusted before it is re-fetched. Default: 900
# FABRIC_ACCESS_TTL_S=900

# Break-glass: serve the last known-good workspace list past its TTL when
# Power BI is unreachable, instead of failing closed. Default: off
# FABRIC_ACCESS_ALLOW_STALE=1


# =============================================================================
# Tenant lineage (Scanner API)
# =============================================================================

# Seconds a scan result is reused. Doubles as a rate-limit guard — the tenant
# allows only 30 modified + 500 getInfo calls per hour. Default: 3600
# LINEAGE_CACHE_TTL_S=3600

# Seconds one scan may run. Default: 600
# LINEAGE_SCAN_TIMEOUT_S=600

# Skip personal workspaces when scanning. Default: 1
# LINEAGE_EXCLUDE_PERSONAL=1

# Downstream reports fetched at visual-level precision; past this they are
# listed as unchecked rather than silently skipped. Default: 40
# LINEAGE_MAX_REPORT_FETCH=40


# =============================================================================
# Power BI Modeling MCP server
# =============================================================================

# Path to the standalone modeling MCP executable. Leave EMPTY on Linux — there
# is no Linux build, and an empty value routes to the npx package below.
# MCP_SERVER_PATH=C:\MCPServers\PowerBIModelingMCP\extension\server\powerbi-modeling-mcp.exe

# Force the npx launcher on (1) or off (0). Default: on whenever
# MCP_SERVER_PATH is empty or not a file.
# MCP_USE_NPX=1

# npm package used by the npx launcher. Default: @microsoft/powerbi-modeling-mcp
# MCP_NPX_PACKAGE=@microsoft/powerbi-modeling-mcp

# Bearer token for the modeling MCP when service-principal auth is unavailable.
# PBI_MODELING_MCP_ACCESS_TOKEN=


# =============================================================================
# Local Power BI Desktop and Tabular Editor (Windows only)
# =============================================================================

# CLI name used to reach a running Power BI Desktop. Default: powerbi-desktop
# PBI_DESKTOP_CLI=powerbi-desktop

# Power BI Desktop executable, for the Desktop bridge tools.
# PBI_DESKTOP_EXE=C:\Program Files\WindowsApps\Microsoft.MicrosoftPowerBIDesktop_Store\bin\PBIDesktop.exe

# TabularEditor.exe, used for BPA runs. .NET Framework — no Linux build exists.
# TE2_PATH=C:/Program Files (x86)/Tabular Editor/TabularEditor.exe

# Best Practice Analyzer rule set. Default: ./tools/bpa/BPARules.json
# BPA_RULES_PATH=

# PBI Inspector CLI and its rule set, used to lint generated reports.
# Defaults: ./tools/pbi-inspector/win-x64/CLI/PBIRInspectorCLI.exe and Base-rules.json
# PBI_INSPECTOR_PATH=
# PBI_INSPECTOR_RULES_PATH=

# Seconds a lint run may take before it is killed. Default: 120
# LINT_TIMEOUT_S=120


# =============================================================================
# Semantic model build and DAX
# =============================================================================

# Validate generated DAX against the live model before applying. Default: 1
# DAX_LIVE_VALIDATE=1

# Run the model assertion suite on every apply. Default: 1
# MODEL_ASSERTIONS_ON_APPLY=1

# Large DAX results are written to disk instead of the transcript.
# Default dir: ./logs/dax_spills
# DAX_SPILL_DIR=
# DAX_SPILL_ROW_THRESHOLD=40
# DAX_SPILL_PREVIEW_ROWS=10
# DAX_SPILL_PAGE_MAX_ROWS=200


# =============================================================================
# Semantic model builder heuristics (SMB_*)
# =============================================================================

# Base measures that get trend variants, and the folder they land in.
# SMB_TREND_MAX_BASES=3
# SMB_TREND_FOLDER=Trends
# SMB_TREND_PCT_FORMAT=0.0%

# Source profiling limits.
# SMB_PROFILE_SAMPLE_CAP=10
# SMB_PROFILE_MAX_TABLES=60

# Column-name patterns that decide a column's role and format.
# SMB_POSTAL_NAME_RX=zip|postal|cep
# SMB_DATE_NAME_RX=(_date|_at|_time|_timestamp|_dt)$
# SMB_INT_NAME_RX=score|rating|(_qty|_count|_num)$
# SMB_PCT_NAME_RX=%|percent|\bpct\b|\brate\b|ratio|margin|share|penetration
# SMB_COUNT_FN_RX=\b(COUNTROWS|COUNTA?|DISTINCTCOUNT|COUNTAX|COUNTX)\s*\(

# Measure format strings.
# SMB_FMT_WHOLE=#,0
# SMB_FMT_DECIMAL=#,0.00
# SMB_FMT_PERCENT=0.0%

# Display folders generated measures are filed under.
# SMB_FOLDER_COUNTS=1. Counts
# SMB_FOLDER_DERIVED=4. Derived


# =============================================================================
# Report generation: design, layout, and quality gates
# =============================================================================

# Page background and the semantic good/bad/neutral colours.
# REPORT_PAGE_BG=#EEF2F7
# SEMANTIC_GOOD=#059669
# SEMANTIC_BAD=#DC2626
# SEMANTIC_MID=#FACC15

# Density gates a generated page must clear before it is accepted.
# REPORT_MIN_COVERAGE_FRAC=0.55
# REPORT_DEAD_MARGIN_FRAC=0.12
# REPORT_COVERAGE_MIN_VISUALS=2

# Widest wireframe the generator will emit, in px. Default: 960
# WIREFRAME_MAX_W=960

# Watermark artwork and its opacity. Default: none
# WATERMARK_SVG_PATH=
# WATERMARK_OPACITY=0.08

# Design-judge score a report must reach, and how many redesign rounds it gets.
# JUDGE_PASS_SCORE=7
# JUDGE_MAX_ROUNDS=3

# Store full report JSON in snapshots — large, so off by default. Default: 0
# SNAPSHOT_REPORT_CONTENT=0

# Figma personal access token, for importing a Figma frame as a wireframe.
# FIGMA_API_KEY=figd_xxxxxxxxxxxxxxxxxxxxxxxx

# Set per chart render so images are filed under the right session; internal.
# PBI_AGENT_SESSION_ID=


# =============================================================================
# Paginated report styling
# =============================================================================

# PAGINATED_HEADER_BG=#1F3864
# PAGINATED_HEADER_TEXT=White
# PAGINATED_ZEBRA_BG=#F2F2F2
# PAGINATED_TITLE_COLOR=#1F3864
# PAGINATED_SUBTITLE_COLOR=#595959
# PAGINATED_BORDER_COLOR=#BFBFBF
# PAGINATED_TOTAL_BG=#D9E1F2
# PAGINATED_GROUP_BG=#DDE3F0
# PAGINATED_POS_COLOR=#006100
# PAGINATED_NEG_COLOR=#C00000


# =============================================================================
# Graph memory (Neo4j)
# =============================================================================

# Connection. Graph memory stays off entirely while NEO4J_URI is empty.
# NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=
# NEO4J_DATABASE=neo4j

# Kill switch that leaves the connection details in place. Default: 1
# GRAPH_MEMORY=1

# Seconds a graph call may block the UI before it is abandoned. Default: 5
# GRAPH_MEMORY_TIMEOUT_S=5

# Seconds to wait after a failure before trying the graph again. Default: 300
# GRAPH_MEMORY_RETRY_AFTER_S=300

# Recall and write limits.
# GRAPH_MEMORY_RECALL_LIMIT=15
# GRAPH_MEMORY_NOTES_PER_PROJECT=100
# GRAPH_MEMORY_SOURCE_TABLES=200
# GRAPH_MEMORY_SOURCE_COLUMNS=60

# Characters of memory injected into a prompt. Default: 8000
# FABRICBI_MEMORY_MAX_CHARS=8000


# =============================================================================
# Langfuse tracing
# =============================================================================

# Tracing is off until both keys are set.
# LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxxxxxxxxxxxxxxxxxx
# LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxxxxxxxxxxxxxxxxxx


# =============================================================================
# Chat API server (the Fabric App backend)
# =============================================================================

# Interface to bind. Anything other than loopback requires HTTPS: the session
# cookie is the entire credential, and without Secure it crosses the network in
# cleartext where it can be captured and replayed. api.server refuses to start
# in that combination. Set ENTRA_REDIRECT_URI to an https:// URL (which turns
# SESSION_COOKIE_SECURE on), or accept the risk on a trusted LAN with
# FABRICBI_ALLOW_INSECURE_SHARED=1. Default: 127.0.0.1
# FABRICBI_AGENT_HOST=127.0.0.1

# Port for the chat API. Default: 8756
# FABRICBI_AGENT_PORT=8756

# LEGACY, read by nothing. It was the bearer credential for /chat back when
# api/chat.py was its own server; api.server took that over and every route is
# gated by the session cookie instead. A security drill found the check
# (_authorized) defined and called by nowhere, so it was removed rather than
# left looking like a layer. Setting this grants and protects nothing.
# FABRICBI_AGENT_TOKEN=

# Browser origins allowed to call the API, comma-separated. Default: the Vite
# dev server on localhost only.
# FABRICBI_FRONTEND_ORIGINS=https://your-frontend.example.com

# Vite dev server port, used only to build the default CORS origins. Default: 5173
# VITE_PORT=5173


# =============================================================================
# Console logging
# =============================================================================

# Per-turn dashboard in the terminal. Default: 1
# CONSOLE_DASHBOARD=1

# ANSI colour. Also disabled by the conventional NO_COLOR. Default: 1
# CONSOLE_COLOR=1
# NO_COLOR=1

# Console width and how much of a prompt is echoed. Defaults: 100 / 2000
# CONSOLE_WIDTH=100
# CONSOLE_PROMPT_CHARS=2000

# Log the entire prompt rather than a truncated one — verbose. Default: 0
# LOG_FULL_PROMPT=0


# =============================================================================
# Container / deployment only
# =============================================================================
# These are read by deploy/*/entrypoint.sh, not by the Python code, and are set
# by the platform or the compose file rather than here.

# Port nginx serves on. Injected by Cloud Run and Render; fixed in the image
# for ACA and the VM.
# PORT=8080

# Host path or mount point the entrypoint builds the data tree under. Default: /data
# FABRICBI_DATA_DIR=/opt/fabricbi/data


# =============================================================================
# Development scripts
# =============================================================================

# scripts/fabric_spike.py connection override, used only by that script.
# FABRIC_SPIKE_SERVER=
# FABRIC_SPIKE_DB=


# =============================================================================
# Provided by the OS, never set here
# =============================================================================
# The code reads these, but they belong to the host rather than to FabricBI:
#   PATH          extended by scripts/qa_mini_build.py so it can find the CLIs
#   LOCALAPPDATA  Windows only — where Power BI Desktop keeps its trace logs
#   HOME          the Claude Code CLI reads its credentials from ~/.claude
